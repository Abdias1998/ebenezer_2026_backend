NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/ebenezer

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Used to sign the opaque code embedded in each registration's QR code.
QR_SECRET=change-me-to-a-different-long-random-string

# Used only by `npm run seed:roles` to create the first Super Admin account.
SEED_SUPER_ADMIN_EMAIL=admin@ebenezer.local
SEED_SUPER_ADMIN_PASSWORD=change-me

# FeexPay (Mobile Money). Renseignés dans le dashboard marchand FeexPay.
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=
FEEXPAY_BASE_URL=https://api-v2.feexpay.me
# URL publique du serveur qui reçoit les notifications FeexPay.
# Doit corresponde à l'URL configurée dans le dashboard FeexPay →
# POST https://<backend>/api/v1/payments/callback
FEEXPAY_CALLBACK_URL=https://votre-backend.example.com/api/v1/payments/callback
